PORT=3000
NODE_ENV=development

# Directory where content.json is persisted. On Railway this should be the
# mount path of an attached volume (e.g. /data) so edits survive redeploys.
DATA_DIR=./data

# Admin login (single admin, no signup routes exist at all)
ADMIN_EMAIL=admin@example.com
# bcrypt hash of the admin password - never put the plaintext password here
ADMIN_PASSWORD_HASH=

# Long random string used to sign admin session JWTs
JWT_SECRET=

# ---- Vritta email invitations (optional; leave blank to disable email) ----
# Uses Resend — the same service ScholarDesk uses. Copy these two values from
# the ScholarDesk project's variables to send from the same verified address.
RESEND_API_KEY=
# e.g. "Vritta <notify@yourdomain>" — defaults to Resend's shared sender
EMAIL_FROM=

# Long random string shared with ScholarDesk for one-click Vritta SSO
VRITTA_SSO_SECRET=
